{
  "manifest_version": 3,
  "name": "x-to-md",
  "version": "2.3.2",
  "description": "Open the current X content assistant to save and copy clean Markdown without images.",
  "permissions": ["activeTab", "storage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*"
  ],
  "action": {
    "default_title": "Open the current X content assistant",
    "default_icon": {
      "16": "assets/icons/x-to-md-icon-16.png",
      "32": "assets/icons/x-to-md-icon-32.png",
      "48": "assets/icons/x-to-md-icon-48.png",
      "128": "assets/icons/x-to-md-icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "assets/icons/x-to-md-icon-16.png",
    "32": "assets/icons/x-to-md-icon-32.png",
    "48": "assets/icons/x-to-md-icon-48.png",
    "128": "assets/icons/x-to-md-icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": ["markdown.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
